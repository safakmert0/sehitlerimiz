{
  "expo": {
    "name": "Şehitlerimiz",
    "slug": "sehitlerimiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sehitlerimiz",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B01E2F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sehitlerimiz.app"
    },
    "android": {
      "package": "com.sehitlerimiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Şehit ve gazilerimizin fotoğraf ve videolarını ekleyebilmeniz için galeri erişimi gereklidir."
        }
      ]
    ]
  }
}
